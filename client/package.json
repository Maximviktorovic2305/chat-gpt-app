{
  "name": "gpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12 <13"
  },
  "scripts": {
    "postinstall": "node scripts/patch-steiger.mjs",
    "test:security": "node --test scripts/steiger-security.test.mjs",
    "dev": "next dev --turbopack -p 3875",
    "build": "next build",
    "start": "next start -p 3875",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-syntax-highlighter": "^16.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.30",
    "steiger": "0.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "steiger": {
      "zod": "4.6.7",
      "zod-validation-error": "4.0.2"
    }
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
